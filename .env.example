# Bexio API Access Token (Personal Access Token)
# Get this from your Bexio account settings under "Apps & Extensions"
BEXIO_ACCESS_TOKEN=

# Optional test-only account capability setting. Leave empty for a full account.
# Set to trial to skip unavailable live payroll and legacy IBAN/QR write flows.
BEXIO_TEST_ACCOUNT_PLAN=

# OAuth2 Configuration (optional, for user-based authentication)
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=
BEXIO_REDIRECT_URI=
