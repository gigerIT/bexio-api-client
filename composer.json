{
  "name": "gigerit/bexio-api-client",
  "type": "library",
  "description": "A PHP client for the Bexio API",
  "version": "3.2.0",
  "keywords": [
    "bexio"
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Bexio\\": "src/",
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Manuel Giger",
      "email": "info@gigeirt.ch"
    }
  ],
  "require": {
    "php": "^8.4",
    "saloonphp/saloon": "^4",
    "illuminate/container": "^11|^12",
    "spatie/laravel-data": "^4",
    "gigerit/spatie-laravel-data-standalone": "^1.0"
  },
  "require-dev": {
    "pestphp/pest": "^v3",
    "pestphp/pest-plugin-faker": "^v3",
    "symfony/var-dumper": "^7",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "^1.29"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "post-install-cmd": [
      "php check-dependency.php"
    ],
    "post-update-cmd": [
      "php check-dependency.php"
    ],
    "test": [
      "vendor/bin/pest"
    ],
    "test:types": "phpstan analyse --memory-limit=2G",
    "lint": "./vendor/bin/pint"
  }
}