{
  "name": "gigerit/bexio-api-client",
  "type": "library",
  "description": "A Laravel package for the Bexio API",
  "keywords": [
    "bexio",
    "laravel",
    "api",
    "client"
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Bexio\\": "src/",
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Manuel Giger",
      "email": "info@gigeirt.ch"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "saloonphp/saloon": "^4",
    "spatie/laravel-data": "^4"
  },
  "require-dev": {
    "orchestra/testbench": "^11",
    "pestphp/pest": "^4",
    "pestphp/pest-plugin-faker": "^4",
    "pestphp/pest-plugin-laravel": "^4",
    "symfony/var-dumper": "^8",
    "phpstan/phpstan": "^2.1"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Bexio\\BexioServiceProvider"
      ],
      "aliases": {
        "Bexio": "Bexio\\Facades\\Bexio"
      }
    }
  },
  "scripts": {
    "test": [
      "vendor/bin/pest"
    ],
    "test:parallel": "php vendor/bin/pest --colors=always -v -p",
    "test:types": "phpstan analyse --memory-limit=2G"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
